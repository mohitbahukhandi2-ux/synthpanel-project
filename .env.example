# Required Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Optional Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional lower-cost validation deployment; defaults to the primary values when omitted
# AZURE_OPENAI_ENDPOINT_NANO=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY_NANO=replace-with-your-nano-key
# AZURE_OPENAI_DEPLOYMENT_NANO=gpt-4.1-nano
# AZURE_OPENAI_API_VERSION_NANO=2025-01-01-preview
